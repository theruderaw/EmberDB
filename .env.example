# EmberDB networking
EMBERDB_ADDR=127.0.0.1:6380

#Connection timeout in seconds
EMBERDB_READ_TIMEOUT_SECS=30
EMBERDB_WRITE_TIMEOUT_SECS=10
EMBERDB_SHUTDOWN_TIMEOUT_SECS=10

# Maximum simultaneously admitted TCP clients
EMBERDB_MAX_CLIENTS=128

# EmberDB recovery passphrase
EMBERDB_RECOVERY_PASSPHRASE=your-secret-passphrase
